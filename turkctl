#!/usr/bin/env bash
# turkctl — AI Turk 제어 스크립트
# 다중 인스턴스: TURK_ENV_FILE 환경변수 또는 --env <파일> 로 .env 파일 지정
set -euo pipefail

# ── nvm 자동 로드 (비대화형 쉘/SSH/systemd 환경 대비) ───────────────────
# node 가 PATH 에 없을 때만 nvm 을 소싱하여 node/npm 을 사용 가능하게 한다.
# (대화형 쉘에서 이미 로드된 경우 아무 동작도 하지 않음)
if ! command -v node >/dev/null 2>&1; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # nvm.sh 일부 버전은 `set -u` 에 취약 → 일시적 해제 후 복구
    set +u; . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true; set -u
  fi
fi

TURK_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$TURK_DIR"

# ── 인자 파싱 ────────────────────────────────────────────────────────────
# 사용법: turkctl [--env <파일> | -e <파일>] <명령>
ENV_FILE=""
ENV_FLAG=""
CMD=""
PROD=0
SUB_ARGS=() # 위치인자 보존 (Phase 2 user 서브커맨드 전달용)
while [ $# -gt 0 ]; do
  case "$1" in
    --env|-e)
      shift
      ENV_FLAG="$1"
      shift
      ;;
    --prod|-p)
      PROD=1
      shift
      ;;
    *)
      if [ -z "$CMD" ]; then
        CMD="$1"         # 첫 위치인자 = 명령 (기존 관례)
      else
        SUB_ARGS+=("$1") # 이후 위치인자 보존 — user 서브커맨드 전달용
      fi
      shift
      ;;
  esac
done

# ENV_FILE 결정: --env 플래그 > TURK_ENV_FILE 환경변수 > 기본 .env
if [ -n "$ENV_FLAG" ]; then
  ENV_FILE="$ENV_FLAG"
elif [ -n "${TURK_ENV_FILE:-}" ]; then
  ENV_FILE="$TURK_ENV_FILE"
else
  ENV_FILE="$TURK_DIR/.env"
fi

# 절대경로 변환
case "$ENV_FILE" in
  /*) ;;
  *)  ENV_FILE="$TURK_DIR/$ENV_FILE" ;;
esac

# 자식 프로세스(vite/server.ts)도 동일 .env 를 읽도록 전파
export TURK_ENV_FILE="$ENV_FILE"

# .env 파일에서 TURK_PORT / TURK_HOST 읽기
# 우선순위: 환경변수 TURK_PORT > TURK_ENV_FILE 파일 > 기본값 3000
if [ -z "${TURK_PORT:-}" ] && [ -f "$ENV_FILE" ]; then
  TURK_PORT="$(grep -E '^TURK_PORT=' "$ENV_FILE" | tail -1 | cut -d'=' -f2- | tr -d '[:space:]' || true)"
fi
TURK_PORT="${TURK_PORT:-3000}"

if [ -z "${TURK_HOST:-}" ] && [ -f "$ENV_FILE" ]; then
  TURK_HOST="$(grep -E '^TURK_HOST=' "$ENV_FILE" | tail -1 | cut -d'=' -f2- | tr -d '[:space:]' || true)"
fi
TURK_HOST="${TURK_HOST:-127.0.0.1}"

LOG_FILE="${TMPDIR:-/tmp}/ai-turk-${TURK_PORT}.log"
PID_FILE="${TMPDIR:-/tmp}/ai-turk-${TURK_PORT}.pid"

# 자식 프로세스(vite/server.ts) 에 전달 — 환경변수로 명시
export TURK_PORT="$TURK_PORT"
export TURK_HOST="$TURK_HOST"

# .env 파일 내용을 환경변수로 로드 (Vite에 전달되도록)
load_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

usage() {
  cat <<EOF
AI Turk 제어 도구

사용법: turkctl [--env <파일>] <명령>

옵션:
  --env <파일>  설정 파일 지정 (기본: .env)
                환경변수 TURK_ENV_FILE 로도 지정 가능 (--env 가 우선)
                예: TURK_ENV_FILE=.env.8003 turkctl start
                    turkctl --env .env.8003 start

명령:
  start     개발 서버 시작 (npm run dev, 백그라운드)
  start --prod  프로덕션 서버 시작 (tsx server.ts, dist/ 정적 서빙)
  stop      서버 및 pi 프로세스 종료 (해당 포트만)
  restart   서버 재시작
  restart --prod  프로덕션 서버 재시작
  status    실행 상태 확인
  logs      최근 로그 출력 (tail -f)
  build     프로덕션 빌드
  pi        pi RPC 프로세스 상태
  ws        WebSocket 연결 테스트
  user      계정 관리 — user-cli 위임 (add·passwd·rm·list·claim)
  session   현재 세션 정보 (HTTP)
  help      이 도움말

예시:
  turkctl start                         # .env 사용 (기본, dev)
  turkctl start --prod                  # 프로덕션 (정적 dist/ + WS)
  TURK_ENV_FILE=.env.8003 turkctl start  # 환경변수로 .env.8003 지정
  turkctl --env .env.8003 start          # 플래그로 .env.8003 지정
  turkctl --env .env.8004 start --prod  # 8004 인스턴스 프로덕션
  turkctl --env .env.8004 restart        # 8004 인스턴스 재시작
  turkctl status
  turkctl logs
EOF
}

is_running() {
  curl -s -o /dev/null -w "%{http_code}" "http://$TURK_HOST:$TURK_PORT/" 2>/dev/null | grep -q 200
}

# 기본 .env 인스턴스는 PM2 'turk' 슬롯이 감시(run.sh prod 경로). start/stop은 pm2 위임해야
# kill→즉시부활 경합이 생기지 않음. --env 커스텀 인스턴스는 기존 nohup 관리 유지.
is_pm2_slot() {
  [ "$ENV_FILE" = "$TURK_DIR/.env" ]
}

# 특정 포트에 묶인 프로세스 종료 (다른 인스턴스 영향 안 줌)
# PID 파일 우선(표준 관리) — 없거나 살아있으면 lsof 폴백(기존 인스턴스 호환)
kill_port() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -9 -"$pid" 2>/dev/null || true      # 프로세스 그룹 전체 (자식/손자 포함)
      pkill -9 -P "$pid" 2>/dev/null || true   # 보조: 직접 자식
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
  local pids
  pids=$(lsof -t -i :"$TURK_PORT" 2>/dev/null || true)
  if [ -n "$pids" ]; then
    for pid in $pids; do
      pkill -9 -P "$pid" 2>/dev/null || true
      kill -9 "$pid" 2>/dev/null || true
    done
  fi
}

# 로그 로테이션: 이전 로그를 타임스탬프 백업으로 보존 (최근 5개 유지)
rotate_log() {
  [ -f "$LOG_FILE" ] || return 0
  local ts backup
  ts=$(date +%Y%m%d-%H%M%S)
  backup="$LOG_FILE.$ts"
  mv -f "$LOG_FILE" "$backup" 2>/dev/null || return 0
  echo "   이전 로그 백업: $backup"
  # 최근 5개만 유지, 오래된 백업 정리
  ls -1t "$LOG_FILE".* 2>/dev/null | tail -n +6 | xargs -r rm -f
}

cmd_start() {
  if is_pm2_slot; then
    if is_running; then
      echo "✅ 이미 실행 중: http://$TURK_HOST:$TURK_PORT (PM2: turk, run.sh prod 경로)"
      return 0
    fi
    echo "▶ PM2 기동 (turk — run.sh prod 경로)..."
    pm2 start turk >/dev/null 2>&1 || pm2 restart turk >/dev/null 2>&1 || true
    sleep 3
    if is_running; then
      echo "✅ 서버 실행 중: http://$TURK_HOST:$TURK_PORT (PM2 turk)"
      echo "   로그: pm2 logs turk"
    else
      echo "❌ PM2 기동 실패 — pm2 logs turk 확인"
      return 1
    fi
    return 0
  fi
  if is_running; then
    echo "✅ 이미 실행 중: http://$TURK_HOST:$TURK_PORT (env: $ENV_FILE)"
    return 0
  fi
  if [ "$PROD" -eq 1 ]; then
    cmd_start_prod
    return $?
  fi
  echo "▶ 서버 시작 중... (포트 $TURK_PORT, env: $ENV_FILE, dev)"
  cd "$TURK_DIR"
  kill_port
  sleep 1
  load_env
  rotate_log
  nohup node "$TURK_DIR/node_modules/vite/bin/vite.js" > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 5
  if is_running; then
    echo "✅ 서버 실행됨: http://$TURK_HOST:$TURK_PORT (dev)"
    echo "   WebSocket: ws://$TURK_HOST:$TURK_PORT/ws"
    echo "   로그: $LOG_FILE"
  else
    echo "❌ 시작 실패 — 로그 확인: turkctl logs"
    tail -5 "$LOG_FILE" 2>/dev/null
    return 1
  fi
}

# 프로덕션 모드: dist/ 정적 서빙 + WS + 백엔드 (tsx server.ts)
cmd_start_prod() {
  echo "▶ 서버 시작 중... (포트 $TURK_PORT, env: $ENV_FILE, prod)"
  cd "$TURK_DIR"
  kill_port
  sleep 1
  load_env
  # dist/ 없으면 빌드
  if [ ! -d "$TURK_DIR/dist" ] || [ ! -f "$TURK_DIR/dist/index.html" ]; then
    echo "   dist/ 없음 — 빌드 수행..."
    npm run build >/dev/null 2>&1 || { echo "❌ 빌드 실패"; return 1; }
  fi
  rotate_log
  nohup npx tsx "$TURK_DIR/server.ts" > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 3
  if is_running; then
    echo "✅ 서버 실행됨: http://$TURK_HOST:$TURK_PORT (prod/static)"
    echo "   WebSocket: ws://$TURK_HOST:$TURK_PORT/ws"
    echo "   로그: $LOG_FILE"
  else
    echo "❌ 시작 실패 — 로그 확인: turkctl logs"
    tail -5 "$LOG_FILE" 2>/dev/null
    return 1
  fi
}

cmd_stop() {
  if is_pm2_slot && pm2 describe turk >/dev/null 2>&1; then
    echo "▶ 중지 중... (PM2: turk)"
    if pm2 stop turk >/dev/null 2>&1; then
      echo "✅ 중지됨 (PM2 상태 stopped — 자부활 없음)"
    else
      kill_port
      echo "✅ 중지됨 (kill_port 폴백)"
    fi
    return 0
  fi
  echo "▶ 중지 중... (포트 $TURK_PORT)"
  kill_port
  echo "✅ 서버 및 관련 프로세스 중지됨 (포트 $TURK_PORT)"
}

cmd_restart() {
  cmd_stop
  sleep 2
  cmd_start "$@"
}

cmd_status() {
  if is_running; then
    echo "✅ 서버 실행 중 (포트 $TURK_PORT, env: $ENV_FILE)"
    local health
    health=$(curl -s "http://$TURK_HOST:$TURK_PORT/api/health" 2>/dev/null || echo "{}")
    echo "   $health"
    if is_pm2_slot; then
      echo "   감시: PM2 'turk' (run.sh prod = tsx dist 서빙)"
    else
      local ws_count
      ws_count=$(grep -c "클라이언트 연결" "$LOG_FILE" 2>/dev/null || echo "0")
      echo "   로그: $LOG_FILE"
    fi
  else
    echo "⚪ 서버 미실행 (포트 $TURK_PORT) — turkctl --env $(basename "$ENV_FILE") start"
  fi
  local procs
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    procs=1
  else
    procs=$(lsof -t -i :"$TURK_PORT" 2>/dev/null | wc -l)
  fi
  echo "   관련 프로세스: ${procs}개"
}

cmd_logs() {
  if is_pm2_slot; then
    echo "(PM2 turk 로그 스트리밍 — Ctrl+C 종료)"
    exec pm2 logs turk
  fi
  if [ -f "$LOG_FILE" ]; then
    tail -f "$LOG_FILE"
  else
    echo "❌ 로그 파일 없음: $LOG_FILE"
  fi
}

cmd_build() {
  cd "$TURK_DIR"
  echo "▶ 빌드 중..."
  npm run build
  echo "✅ 빌드 완료: $TURK_DIR/dist/"
}

cmd_pi() {
  if is_running; then
    echo "=== pi 프로세스 ==="
    ps aux | grep "pi --mode rpc" | grep -v grep || echo "  pi 프로세스 없음"
    echo "=== 헬스체크 ==="
    curl -s "http://$TURK_HOST:$TURK_PORT/api/health" 2>/dev/null || echo "  응답 없음"
    echo
  else
    echo "⚪ 서버 미실행 (포트 $TURK_PORT)"
  fi
}

cmd_ws() {
  if ! is_running; then
    echo "⚪ 서버 미실행 (포트 $TURK_PORT)"
    return 1
  fi
  echo "=== WebSocket 테스트 (포트 $TURK_PORT) ==="
  cd "$TURK_DIR"
  npx tsx -e '
import WebSocket from "ws";
const ws = new WebSocket("ws://'"$TURK_HOST"':'"$TURK_PORT"'/ws?u=turkctl-probe");
ws.on("open", () => { console.log("✅ WS 연결됨"); ws.send(JSON.stringify({ type: "get_state" })); });
ws.on("message", (raw) => {
  const msg = JSON.parse(raw.toString());
  if (msg.type === "session_error") { console.error("❌ 세션 오류:", msg.error); process.exit(1); }
  if (msg.type === "pi_ready") console.log("✅ pi 준비됨");
  if (msg.type === "response" && msg.command === "get_state") {
    console.log("세션:", msg.data?.sessionId ?? "—");
    console.log("메시지 수:", msg.data?.messageCount ?? 0);
    ws.close(); process.exit(0);
  }
});
ws.on("error", (e) => { console.error("❌ WS 오류:", e.message); process.exit(1); });
setTimeout(() => { console.log("타임아웃"); process.exit(1); }, 10000);
' 2>&1
}

cmd_session() {
  if ! is_running; then
    echo "⚪ 서버 미실행 (포트 $TURK_PORT)"
    return 1
  fi
  cd "$TURK_DIR"
  npx tsx -e '
import WebSocket from "ws";
const ws = new WebSocket("ws://'"$TURK_HOST"':'"$TURK_PORT"'/ws?u=turkctl-probe");
ws.on("open", () => ws.send(JSON.stringify({ type: "get_state" })));
ws.on("message", (raw) => {
  const msg = JSON.parse(raw.toString());
  if (msg.type === "response" && msg.command === "get_state" && msg.success) {
    const d = msg.data;
    console.log("세션 ID:", d.sessionId ?? "—");
    console.log("세션명:", d.sessionName ?? "—");
    console.log("모델:", d.model?.name ?? d.model?.id ?? "—");
    console.log("메시지 수:", d.messageCount ?? 0);
    console.log("사고 레벨:", d.thinkingLevel ?? "—");
    console.log("스트리밍:", d.isStreaming ? "예" : "아니오");
    ws.close(); process.exit(0);
  }
});
setTimeout(() => { console.log("타임아웃"); process.exit(1); }, 10000);
' 2>&1
}

# ── 메인 ────────────────────────────────────────────────────────────────
case "${CMD:-help}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  build)   cmd_build ;;
  pi)      cmd_pi ;;
  ws)      cmd_ws ;;
  session) cmd_session ;;
  user)
    # Phase 2 계정 관리 — user-cli.ts 위임 (add·passwd·rm·list·claim; exit code 전파)
    npx tsx "$TURK_DIR/user-cli.ts" ${SUB_ARGS[@]+"${SUB_ARGS[@]}"}
    ;;
  help|--help|-h) usage ;;
  "") usage ;;
  *) echo "알 수 없는 명령: $CMD"; usage; exit 1 ;;
esac